---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { publicFileExists } from '../utils/assets';
import { isPreviewBuild } from '../data/drafts';

interface Props {
  title: string;
  description: string;
  /** true: header, sayfanın ilk bölümü (hero) üstünde şeffaf başlar */
  overHero?: boolean;
  /** false: footer’daki harita şeridini gizler (sayfada zaten büyük harita varsa) */
  footerMap?: boolean;
  /** false: footer’daki "Projeniz için teklif alın" şeridini gizler (ana sayfada iletişim bölümü var) */
  footerCta?: boolean;
  /** true: site yayına çıksa bile sayfa noindex kalır */
  noindex?: boolean;
  /** true: bölüm başlıklarındaki küçük etiket (eyebrow) "01 — " gibi sırayla numaralanır */
  numbered?: boolean;
}

const {
  title,
  description,
  overHero = false,
  footerMap = true,
  footerCta = true,
  noindex = false,
  numbered = false,
} = Astro.props;

// Hero başlığında kullanılan Archivo (latin) dosyası; scripts/subset-fonts.mjs üretir
const heroFont = publicFileExists('/fonts/archivo-latin.woff2') ? '/fonts/archivo-latin.woff2' : null;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14161a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      heroFont && (
        <link rel="preload" as="font" type="font/woff2" href={heroFont} crossorigin />
      )
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <SEO title={title} description={description} noindex={noindex} />
    <slot name="head" />
    <!-- Sayfa geçişleri (Astro View Transitions). Hareket azaltma açıkken animasyon yok (global.css). -->
    <ClientRouter />
  </head>
  <body class:list={[overHero && 'over-hero', isPreviewBuild && 'has-preview']}>
    {
      isPreviewBuild && (
        <div class="preview-bar" role="note">
          Önizleme sürümü – içerikler onay bekliyor
        </div>
      )
    }
    <Header />
    <main id="icerik" tabindex="-1" class:list={[numbered && 'numbered']}>
      <slot />
    </main>
    <Footer map={footerMap} cta={footerCta} />
    <FloatingActions />
    <MobileCallBar />
    <script>
      import '../scripts/page-init.js';
    </script>
  </body>
</html>
