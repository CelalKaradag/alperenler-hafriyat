---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroInfoStrip from '../components/HeroInfoStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatsStrip from '../components/StatsStrip.astro';
import GallerySection from '../components/GallerySection.astro';
import HowWeWork from '../components/HowWeWork.astro';
import ContactQuote from '../components/ContactQuote.astro';
import FaqSection from '../components/FaqSection.astro';
import JsonLd from '../components/JsonLd.astro';
import { approvedFaqs } from '../data/faq';
import { mapsUrl, site } from '../data/site';
import { faqSchema, localBusinessSchema } from '../utils/schema';
import { visibleServices } from '../data/services';
import { publicFileExists } from '../utils/assets';

// Görsel yoksa sağ sütunda yalnızca "Firma Bilgileri" kartı görünür.
const aboutImage = '/images/hakkimizda.jpg';
const hasAboutImage = publicFileExists(aboutImage);
---

<BaseLayout
  overHero
  footerCta={false}
  title={`${site.name} | Malatya Yeşilyurt`}
  description={`${site.legalName}, Malatya Yeşilyurt'ta. İhtiyacınızı konuşmak için doğrudan arayabilirsiniz: ${site.phone.display}.`}
>
  <Fragment slot="head">
    <JsonLd data={localBusinessSchema(Astro.site)} />
    {approvedFaqs.length > 0 && <JsonLd data={faqSchema(approvedFaqs)} />}
  </Fragment>

  <Hero scrollTarget="#firma" />
  <HeroInfoStrip />

  <section id="firma" class="section section-light" aria-labelledby="firma-baslik">
    <div class="container about reveal">
      <div class="about-copy">
        <div class="section-head">
          <p class="eyebrow">Biz Kimiz</p>
          <h2 id="firma-baslik">{site.legalName}</h2>
        </div>
        <p>
          {site.legalName}, Koyunoğlu Mahallesi'nde, Yeşilyurt / Malatya adresinde yer alır.
          Çalışmaya başlamadan önce ihtiyacı doğrudan konuşmak, işin doğru anlaşılması için en
          sağlıklı yoldur.
        </p>
        <p>
          <a class="text-link" href="/hakkimizda/">Hakkımızda<span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </div>

      <div class:list={['about-side', hasAboutImage && 'about-side--photo']}>
        {
          hasAboutImage && (
            <div class="about-media">
              <img src={aboutImage} alt="" loading="lazy" decoding="async" />
            </div>
          )
        }
        <aside class="company-card on-dark" aria-labelledby="firma-bilgileri">
          <h3 id="firma-bilgileri">Firma Bilgileri</h3>
          <dl class="company-list">
            <div>
              <dt>Firma adı</dt>
              <dd>{site.legalName}</dd>
            </div>
            <div>
              <dt>Adres</dt>
              <dd><address>{site.address}</address></dd>
            </div>
            <div>
              <dt>Telefon</dt>
              <dd><a href={site.phone.href}>{site.phone.display}</a></dd>
            </div>
            <div>
              <dt>Harita</dt>
              <dd>
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
                  Google Maps'te göster<span class="visually-hidden"> (yeni sekmede açılır)</span>
                </a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <StatsStrip />

  {
    visibleServices.length > 0 && (
      <section class="section section-dark on-dark" aria-labelledby="hizmetler-baslik">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">Hizmetler</p>
            <h2 id="hizmetler-baslik">Neler yapıyoruz?</h2>
          </div>
          <div class="card-grid">
            {visibleServices.map((service, i) => (
              <div class="reveal" style={`--d: ${(i % 4) * 0.07}s`}>
                <ServiceCard service={service} index={i + 1} />
              </div>
            ))}
          </div>
          <p class="section-more reveal">
            <a class="text-link" href="/hizmetler/">
              Tüm hizmetler<span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    )
  }

  <GallerySection />

  <HowWeWork />

  <FaqSection />

  <ContactQuote />
</BaseLayout>
