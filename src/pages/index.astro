---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroMarquee from '../components/HeroMarquee.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatsStrip from '../components/StatsStrip.astro';
import TrustStrip from '../components/TrustStrip.astro';
import GallerySection from '../components/GallerySection.astro';
import ReferencesSection from '../components/ReferencesSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import HowWeWork from '../components/HowWeWork.astro';
import PriceWizard from '../components/PriceWizard.astro';
import TopoArt from '../components/TopoArt.astro';
import LogoMark from '../components/LogoMark.astro';
import Picture from '../components/Picture.astro';
import FaqSection from '../components/FaqSection.astro';
import JsonLd from '../components/JsonLd.astro';
import { approvedFaqs, visibleFaqs } from '../data/faq';
import { site } from '../data/site';
import { faqSchema, localBusinessSchema } from '../utils/schema';
import { visibleServices } from '../data/services';
import { publicFileExists } from '../utils/assets';

// Fotoğraf yoksa sağ sütunda dekoratif koyu panel görünür (iletişim bilgisi yok).
const aboutIntro =
  `Alperenler Hafriyat İnşaat, ${site.foundedYear} yılından bu yana Malatya'da hafriyat, kazı ve iş makinesi hizmetleri veriyor. Yıllar içinde edindiğimiz deneyimi, disiplinli çalışma anlayışımızı ve müşteri memnuniyetini önceleyen yaklaşımımızı her işe yansıtıyoruz.`;
const aboutImage = '/images/hakkimizda.jpg';
const hasAboutImage = publicFileExists(aboutImage);
---

<BaseLayout
  overHero
  numbered
  footerCta={false}
  title={`${site.name} | Malatya Yeşilyurt`}
  description={`${site.legalName}, Malatya Yeşilyurt’ta. İhtiyacınızı konuşmak için doğrudan arayabilirsiniz: ${site.phone.display}.`}
>
  <Fragment slot="head">
    <JsonLd data={localBusinessSchema(Astro.site)} />
    {approvedFaqs.length > 0 && <JsonLd data={faqSchema(approvedFaqs)} />}
  </Fragment>

  <Hero scrollTarget="#firma" />
  <HeroMarquee />

  <section id="firma" class="section section-light" aria-labelledby="firma-baslik">
    <div class="container about reveal">
      <div class="about-copy">
        <div class="section-head">
          <p class="eyebrow">Biz Kimiz</p>
          <h2 id="firma-baslik">{`${site.foundedYear}'den bu yana Malatya'da hafriyat ve iş makinesi hizmetleri`}</h2>
        </div>
        <p>{aboutIntro}</p>
        <p>
          <a class="text-link" href="/hakkimizda/">Hakkımızda<span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </div>

      {
        hasAboutImage ? (
          <div class="about-media">
            <Picture
              src={aboutImage}
              alt="Kayalık arazide çalışan Hitachi ekskavatör"
              width={1000}
              height={1333}
              sizes="(min-width: 56em) 40vw, 100vw"
            />
          </div>
        ) : (
          <div class="about-panel" aria-hidden="true">
            <TopoArt variant="soft" />
            <LogoMark class="about-panel-mark" />
            <p class="about-panel-label">YEŞİLYURT · MALATYA</p>
          </div>
        )
      }    </div>
  </section>

  <ReferencesSection />

  <StatsStrip />

  <TrustStrip />

  {
    visibleServices.length > 0 && (
      <section class="section section-dark on-dark" aria-labelledby="hizmetler-baslik">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">Hizmetler</p>
            <h2 id="hizmetler-baslik">Neler yapıyoruz?</h2>
          </div>
          <div class="card-grid">
            {visibleServices.map((service, i) => (
              <div class="reveal" style={`--d: ${(i % 4) * 0.08}s`}>
                <ServiceCard service={service} index={i + 1} />
              </div>
            ))}
          </div>
          <p class="section-more reveal">
            <a class="text-link" href="/hizmetler/">
              Tüm hizmetler<span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- Liste (src/data/reviews.ts) boşken hiçbir şey render edilmez -->
  <ReviewsSection />

  <GallerySection />

  <HowWeWork />

  <FaqSection />

  <!-- Fiyat + sihirbaz (açık zemin): footer’ın koyu harita şeridinden önce son bölüm. SSS görünürse zemin tonu değişir. -->
  <PriceWizard tone={visibleFaqs.length > 0 ? 'paper' : 'light'} />
</BaseLayout>
