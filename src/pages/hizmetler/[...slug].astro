---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import TopoArt from '../../components/TopoArt.astro';
import JsonLd from '../../components/JsonLd.astro';
import FaqSection from '../../components/FaqSection.astro';
import { approvedFaqs } from '../../data/faq';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../utils/schema';
import { visibleMachines } from '../../data/machines';
import { guidesForService } from '../../data/guides';
import RelatedLinks from '../../components/RelatedLinks.astro';
import CalcPromo from '../../components/CalcPromo.astro';
import { defaultPriceFactors, visibleServices, type Service } from '../../data/services';
import { site, whatsappLink, whatsappServiceMessage } from '../../data/site';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import GallerySection from '../../components/GallerySection.astro';
import Picture from '../../components/Picture.astro';
import { publicFileExists } from '../../utils/assets';
import { imageSize } from '../../utils/image-size';
import { getGalleryEntries } from '../../utils/gallery';

// /hizmetler/ (liste) ve /hizmetler/<slug>/ (detay) tek dosyada üretilir.
// Görünür hizmet yoksa (yayında onaylı hizmet yok) hiçbir sayfa üretilmez.
export function getStaticPaths() {
  if (visibleServices.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { service: null } },
    ...visibleServices.map((item) => ({ params: { slug: item.slug }, props: { service: item } })),
  ];
}

const { service } = Astro.props as { service: Service | null };
const others = service ? visibleServices.filter((item) => item.slug !== service.slug) : [];
const factors = service?.priceFactors ?? defaultPriceFactors;
// Hizmete özel hazır mesaj; WhatsApp numarası yoksa null
const waLink = service ? whatsappLink(whatsappServiceMessage(service.title)) : null;
// Başlık bölümünün arka plan görseli (hizmet görseli); dosya yoksa düz koyu zemin
const headImage = service && publicFileExists(service.image) ? service.image : null;
const headSize = headImage ? imageSize(headImage) : null;
// İlgili galeri şeridi varsa "Diğer hizmetler" açık, yoksa kum zeminde (komşu bölümlerle aynı ton olmasın)
const hasRelated = service
  ? getGalleryEntries().some((entry) => entry.item.services?.includes(service.slug))
  : false;

// İlgili makine kiralama sayfaları (iç bağlantı)
const relatedMachines = service
  ? visibleMachines.filter((machine) => machine.relatedServices.includes(service.slug))
  : [];
// İlgili rehber yazılar (iç bağlantı)
const relatedGuides = service ? guidesForService(service.slug) : [];
// Hacim hesabının işe yaradığı hizmetlerde hafriyat hesaplama bağlantısı
const calcServices = ['hafriyat-ve-temel-kazisi', 'hafriyat-kamyonu-ve-moloz-tasima'];
// Taslak içerik sayfaları noindex (site yayına çıksa bile onaylanana kadar)
const anyApproved = visibleServices.some((item) => item.onaylandi);
const noindex = service ? !service.onaylandi : !anyApproved;

const title = service
  ? `${service.seoName} Malatya | ${site.name}`
  : `Hizmetler | ${site.name}`;
const description = service
  ? service.summary
  : `${site.legalName} hizmetleri: hafriyat, kazı, yıkım ve iş makinesi işleri. Malatya’da ihtiyacınızı konuşmak için arayın.`;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Fragment slot="head">
    {service?.onaylandi && <JsonLd data={serviceSchema(service, Astro.site)} />}
    {
      service?.onaylandi && Astro.site && (
        <JsonLd
          data={breadcrumbSchema(
            [
              { name: 'Ana Sayfa', path: '/' },
              { name: 'Hizmetler', path: '/hizmetler/' },
              { name: service.seoName, path: `/hizmetler/${service.slug}/` },
            ],
            Astro.site,
          )}
        />
      )
    }
    {!service && approvedFaqs.length > 0 && <JsonLd data={faqSchema(approvedFaqs)} />}
  </Fragment>
  {
    service ? (
      <>
        <section class="page-head on-dark">
          {
            headImage && (
              <div class="page-head-media" aria-hidden="true">
                <Picture
                  src={headImage}
                  alt=""
                  width={headSize?.width ?? 1600}
                  height={headSize?.height ?? 1000}
                  loading="eager"
                  sizes="100vw"
                />
              </div>
            )
          }
          <TopoArt variant="soft" />
          <div class="container narrow">
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <ol>
                <li><a href="/">Ana Sayfa</a></li>
                <li><a href="/hizmetler/">Hizmetler</a></li>
                <li aria-current="page">{service.seoName}</li>
              </ol>
            </nav>
            <h1>{service.title}</h1>
            <p class="lead">{service.summary}</p>
            {!service.onaylandi && <p><span class="draft-badge">TASLAK</span></p>}
          </div>
        </section>

        <section class="section section-light">
          <div class="container detail-grid">
            <div class="prose">
              {service.detail.map((paragraph) => <p>{paragraph}</p>)}

              <h2>Bu hizmet ne zaman gerekir?</h2>
              <ul class="check-list">
                {
                  service.whenNeeded.map((item) => (
                    <li>
                      <Icon name="check" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>

              <h2>Fiyatı neler belirler?</h2>
              <p>
                Fiyat, işin koşullarına göre belirlenir. Teklif için şu bilgilerin paylaşılması
                yeterlidir:
              </p>
              <ul class="check-list">
                {
                  factors.map((item) => (
                    <li>
                      <Icon name="check" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
              {calcServices.includes(service.slug) && <CalcPromo />}
              <RelatedLinks
                heading="İlgili makine kiralama"
                items={relatedMachines.map((machine) => ({
                  href: `/makine-kiralama/${machine.slug}/`,
                  title: machine.title,
                  icon: machine.icon,
                  draft: !machine.onaylandi,
                }))}
              />
              <RelatedLinks
                heading="İlgili rehber yazılar"
                items={relatedGuides.map((guide) => ({
                  href: `/rehber/${guide.slug}/`,
                  title: guide.title,
                  icon: 'check',
                  draft: !guide.onaylandi,
                }))}
              />
            </div>

            <aside class="call-card on-dark" aria-label="Teklif için arayın">
              <Icon name="phone" />
              <h2>Teklif için arayın</h2>
              <p>İşi anlatın, ihtiyacınıza göre teklif hazırlayalım.</p>
              <a class="btn btn-primary btn-lg" href={site.phone.href}>
                {site.phone.display}
              </a>
              {
                waLink && (
                  <WhatsAppButton class="btn btn-wa btn-lg call-card-wa" href={waLink} />
                )
              }
            </aside>
          </div>
        </section>

        <GallerySection variant="related" serviceSlug={service.slug} />

        {
          others.length > 0 && (
            <section
              class:list={['section', hasRelated ? 'section-light' : 'section-paper']}
              aria-labelledby="diger-baslik"
            >
              <div class="container">
                <div class="section-head">
                  <p class="eyebrow">Hizmetler</p>
                  <h2 id="diger-baslik">Diğer hizmetler</h2>
                </div>
                <ul class="link-list">
                  {others.map((item) => (
                    <li>
                      <a href={`/hizmetler/${item.slug}/`}>
                        <Icon name={item.icon} />
                        <span>{item.title}</span>
                        <Icon class="link-list-arrow" name="arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }
      </>
    ) : (
      <>
        <section class="page-head on-dark">
          <TopoArt variant="soft" />
          <div class="container narrow">
            <p class="eyebrow">Neler yapıyoruz?</p>
            <h1>Hizmetler</h1>
            <p class="lead">
              Hafriyat, kazı, yıkım ve iş makinesi işleri. Malatya’da ihtiyacınızı anlatmak için
              bizi arayabilirsiniz.
            </p>
          </div>
        </section>

        <section class="section section-light section--flush-top">
          <div class="container">
            <div class="card-grid">
              {visibleServices.map((item, i) => (
                <div class="reveal" style={`--d: ${(i % 4) * 0.08}s`}>
                  <ServiceCard service={item} index={i + 1} />
                </div>
              ))}
            </div>
          </div>
        </section>

        {
          visibleMachines.length > 0 && (
            <section class="section section-paper" aria-labelledby="makine-baslik">
              <div class="container">
                <div class="section-head">
                  <p class="eyebrow">Makine kiralama</p>
                  <h2 id="makine-baslik">Operatörlü makine kiralama</h2>
                </div>
                <p class="rail-hint" aria-hidden="true">
                  Kaydırarak tüm makineleri görün<span class="rail-hint-arrow">→</span>
                </p>
                <div class="card-grid card-grid--rail">
                  {visibleMachines.map((machine, i) => (
                    <ServiceCard service={machine} index={i + 1} basePath="/makine-kiralama/" />
                  ))}
                </div>
                <p class="section-more">
                  <a class="text-link" href="/makine-kiralama/">
                    Tüm makine kiralama sayfaları<span class="arrow" aria-hidden="true">→</span>
                  </a>
                </p>
              </div>
            </section>
          )
        }

        <FaqSection tone={visibleMachines.length > 0 ? 'light' : 'paper'} />
      </>
    )
  }
</BaseLayout>
