---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import TopoArt from '../../components/TopoArt.astro';
import JsonLd from '../../components/JsonLd.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { visibleRegions, type Region } from '../../data/regions';
import { visibleServices } from '../../data/services';
import { site, whatsappLink } from '../../data/site';
import { breadcrumbSchema } from '../../utils/schema';

// /bolgeler/ (liste) ve /bolgeler/<slug>/ (detay) tek dosyada üretilir.
// Görünür bölge yoksa (yayında onaylı bölge yok) hiçbir sayfa üretilmez.
export function getStaticPaths() {
  if (visibleRegions.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { region: null } },
    ...visibleRegions.map((item) => ({ params: { slug: item.slug }, props: { region: item } })),
  ];
}

const { region } = Astro.props as { region: Region | null };
const others = region ? visibleRegions.filter((item) => item.slug !== region.slug) : [];
const waLink = region
  ? whatsappLink(`Merhaba, web sitenizden ulaşıyorum. ${region.locative} hafriyat, kazı veya iş makinesi işi için teklif almak istiyorum.`)
  : null;

// Taslak sayfalar noindex (site yayına çıksa bile onaylanana kadar)
const anyApproved = visibleRegions.some((item) => item.onaylandi);
const noindex = region ? !region.onaylandi : !anyApproved;

const title = region ? `${region.name} Hafriyat | ${site.name}` : `Hizmet Bölgeleri | ${site.name}`;
const description = region
  ? `${region.intro} ${site.legalName}.`
  : `${site.legalName} hizmet bölgeleri: Malatya ilçeleri. İşinizin yerini yazın veya bizi arayın.`;

// Bölgeye göre ortak "Teklif için gerekenler" (rakam/iddia yok)
const quoteNeeds = [
  'İşin türü (hafriyat, kazı, yıkım, makine kiralama vb.)',
  'Sahanın bulunduğu mahalle veya köy ve yaklaşık konumu',
  'Varsa yaklaşık ölçüler veya miktar',
  'Sahaya makinenin ve kamyonun girişinin uygun olup olmadığı',
  'İşin ne zaman yapılmasını istediğiniz',
];
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Fragment slot="head">
    {
      region?.onaylandi && Astro.site && (
        <JsonLd
          data={breadcrumbSchema(
            [
              { name: 'Ana Sayfa', path: '/' },
              { name: 'Hizmet bölgeleri', path: '/bolgeler/' },
              { name: region.name, path: `/bolgeler/${region.slug}/` },
            ],
            Astro.site,
          )}
        />
      )
    }
  </Fragment>
  {
    region ? (
      <>
        <section class="page-head on-dark">
          <TopoArt variant="soft" />
          <div class="container narrow">
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <ol>
                <li><a href="/">Ana Sayfa</a></li>
                <li><a href="/bolgeler/">Hizmet bölgeleri</a></li>
                <li aria-current="page">{region.name}</li>
              </ol>
            </nav>
            <h1>{region.name} Hafriyat</h1>
            <p class="lead">{region.intro}</p>
            {!region.onaylandi && <p><span class="draft-badge">TASLAK</span></p>}
          </div>
        </section>

        <section class="section section-light">
          <div class="container detail-grid">
            <div class="prose">
              {
                !region.onaylandi && (
                  <p class="draft-notice" role="note">
                    <span class="draft-badge">TASLAK</span> Bu bölgeye hizmet verildiği onaylanmadı.
                  </p>
                )
              }

              <h2>{region.name} için teklif almak</h2>
              <p>
                İşin yerini ve türünü anlatmanız yeterlidir. Bizi arayabilir veya hazır mesajla
                WhatsApp’tan yazabilirsiniz; teklif işin ayrıntıları öğrenildikten sonra hazırlanır.
              </p>

              <h2>Teklif için gerekenler</h2>
              <ul class="check-list">
                {
                  quoteNeeds.map((item) => (
                    <li>
                      <Icon name="check" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>

              <p>
                <a class="text-link" href={`/teklif/?yer=${encodeURIComponent(region.name)}`}>
                  Teklif mesajını hazırla<span class="arrow" aria-hidden="true">→</span>
                </a>
              </p>
            </div>

            <aside class="call-card on-dark" aria-label="Teklif için arayın">
              <Icon name="phone" />
              <h2>Teklif için arayın</h2>
              <p>İşi anlatın, ihtiyacınıza göre teklif hazırlayalım.</p>
              <a class="btn btn-primary btn-lg" href={site.phone.href}>
                {site.phone.display}
              </a>
              {waLink && <WhatsAppButton class="btn btn-wa btn-lg call-card-wa" href={waLink} />}
            </aside>
          </div>
        </section>

        {
          visibleServices.length > 0 && (
            <section class="section section-paper" aria-labelledby="bolge-hizmet-baslik">
              <div class="container">
                <div class="section-head">
                  <p class="eyebrow">Hizmetler</p>
                  <h2 id="bolge-hizmet-baslik">Hizmetlerimiz</h2>
                </div>
                <p class="rail-hint" aria-hidden="true">
                  Kaydırarak tüm hizmetleri görün<span class="rail-hint-arrow">→</span>
                </p>
                <div class="card-grid card-grid--rail">
                  {visibleServices.map((service, i) => (
                    <ServiceCard service={service} index={i + 1} />
                  ))}
                </div>
              </div>
            </section>
          )
        }

        {
          others.length > 0 && (
            <section class="section section-light" aria-labelledby="diger-bolge-baslik">
              <div class="container">
                <div class="section-head">
                  <p class="eyebrow">Hizmet bölgeleri</p>
                  <h2 id="diger-bolge-baslik">Diğer bölgeler</h2>
                </div>
                <ul class="link-list">
                  {others.map((item) => (
                    <li>
                      <a href={`/bolgeler/${item.slug}/`}>
                        <Icon name="pin" />
                        <span>{item.name}</span>
                        {!item.onaylandi && <span class="draft-badge">TASLAK</span>}
                        <Icon class="link-list-arrow" name="arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }
      </>
    ) : (
      <>
        <section class="page-head on-dark">
          <TopoArt variant="soft" />
          <div class="container narrow">
            <p class="eyebrow">Malatya</p>
            <h1>Hizmet Bölgeleri</h1>
            <p class="lead">
              Malatya ilçeleri için hafriyat, kazı ve iş makinesi ihtiyacınızı anlatmak üzere bizi
              arayabilirsiniz.
            </p>
            {visibleRegions.some((item) => !item.onaylandi) && (
              <p class="draft-notice" role="note">
                <span class="draft-badge">TASLAK</span> Bu bölgelere hizmet verildiği onaylanmadı.
              </p>
            )}
          </div>
        </section>

        <section class="section section-light section--flush-top">
          <div class="container">
            <ul class="link-list">
              {visibleRegions.map((item) => (
                <li>
                  <a href={`/bolgeler/${item.slug}/`}>
                    <Icon name="pin" />
                    <span>{item.name}</span>
                    {!item.onaylandi && <span class="draft-badge">TASLAK</span>}
                    <Icon class="link-list-arrow" name="arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>
