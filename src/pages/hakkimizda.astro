---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import GallerySection from '../components/GallerySection.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import ReferencesSection from '../components/ReferencesSection.astro';
import TopoArt from '../components/TopoArt.astro';
import { visibleServices } from '../data/services';
import { mapsDirectionsUrl, mapsUrl, site } from '../data/site';
import { publicFileExists } from '../utils/assets';
import { imageSize } from '../utils/image-size';

const intro = `Alperenler Hafriyat İnşaat, ${site.foundedYear} yılından bu yana Malatya'da hafriyat, kazı, altyapı ve iş makinesi hizmetleri veriyor. Malatya merkez ve ilçelerinin yanı sıra şehir dışındaki projelerde de çalışıyoruz. Yıllar içinde edindiğimiz deneyimi, disiplinli çalışma anlayışımızı ve müşteri memnuniyetini önceleyen yaklaşımımızı her işe yansıtıyoruz.`;
const pillars = [
  {
    icon: 'pin',
    title: 'İşe başlamadan önce sahayı tanırız',
    text: 'Gelen her talebi hızla değerlendiriyor, çalışılacak alanın zemin ve arazi yapısını ekibimizle yerinde inceliyoruz. Planlamayı sahaya göre yapıyor, işi baştan doğru kuruyoruz.',
  },
  {
    icon: 'calendar',
    title: 'Söz verdiğimiz sürede teslim',
    text: 'Üstlendiğimiz işleri taahhüt ettiğimiz süre içinde tamamlayıp teslim etmeyi temel ilkemiz olarak görüyoruz.',
  },
  {
    icon: 'machine',
    title: 'Büyüyen ve yenilenen filo',
    text: 'Artan iş hacmine paralel olarak iş makinelerimizi, araç ve ekipmanlarımızı yeniliyor, daha hızlı ve verimli hizmet için yatırım yapmaya devam ediyoruz.',
  },
] as const;
const photo = '/images/hakkimizda.jpg';
const hasPhoto = publicFileExists(photo);
const photoSize = hasPhoto ? imageSize(photo) : null;
---

<BaseLayout
  title={`Hakkımızda | ${site.name}`}
  description={`${site.legalName}, ${site.foundedYear}'den bu yana Malatya'da hafriyat, kazı, altyapı ve iş makinesi hizmetleri veriyor. Referanslarımız ve tamamlanan işlerimiz.`}
>
  <section class:list={['page-head', 'on-dark', hasPhoto && 'page-head--tall']}>
    {
      hasPhoto && (
        <div class="page-head-media" aria-hidden="true">
          <Picture
            src={photo}
            alt=""
            width={photoSize?.width ?? 1000}
            height={photoSize?.height ?? 1333}
            loading="eager"
            sizes="100vw"
          />
        </div>
      )
    }
    <TopoArt variant="soft" />
    <div class="container narrow">
      <p class="eyebrow">Hakkımızda</p>
      <h1>{site.legalName}</h1>
      <p class="page-head-sub">{`${site.foundedYear}'den bu yana Malatya'da`}</p>
    </div>
  </section>

  <section class="section section-light about-intro-section">
    <div class="container">
      <p class="about-intro">{intro}</p>
    </div>
  </section>

  <section class="section section-paper about-pillars-section" aria-labelledby="ilkeler-baslik">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Çalışma ilkelerimiz</p>
        <h2 id="ilkeler-baslik">Çalışma ilkelerimiz</h2>
      </div>
      <ul class="pillars">
        {
          pillars.map((p) => (
            <li class="pillar">
              <span class="pillar-icon"><Icon name={p.icon} /></span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-light about-infra-section" aria-labelledby="altyapi-baslik">
    <div class="container">
      <div class="prose">
        <h2 id="altyapi-baslik">Altyapı ve taş duvar</h2>
        <p>Hafriyat ve kazının yanında altyapı işlerinde de uzun soluklu bir deneyime sahibiz. Kurumsal projelerde ve İller Bankası işlerinde taşeron olarak Ankara, Manisa, Sivas ve Malatya'da altyapı çalışmaları yürüttük. Taş duvar işçiliğindeki deneyimli kadromuzla bu alanda da hizmet veriyoruz.</p>
      </div>
    </div>
  </section>

  <ReferencesSection />

  <section class="section section-light about-quote-section">
    <div class="container">
      <blockquote class="about-quote">
        <p>{`Altyapıdaki tecrübemiz ve taş duvar işçiliğindeki kadromuzla, ${site.foundedYear}'den bu yana olduğu gibi bugün de tüm gönüllerde taht kuruyoruz.`}</p>
      </blockquote>
    </div>
  </section>

  <section class="section section-dark on-dark about-goal-band" aria-labelledby="hedef-baslik">
    <div class="container">
      <div class="about-goal">
        <p class="eyebrow">Hedefimiz</p>
        <h2 id="hedef-baslik" class="visually-hidden">Hedefimiz</h2>
        <p class="about-goal-text">Uzman ekibimiz ve güçlü filomuzla kaliteden ve müşteri memnuniyetinden ödün vermeden çalışmak; çevremizle birlikte daha verimli ve çağdaş bir hizmet anlayışını büyütmek.</p>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="container about-page">
      <div class="prose">
        <h2>Bize nasıl ulaşırsınız?</h2>
        <p>En hızlı yol telefondur. Adresimiz ve harita bağlantısı iletişim sayfasında yer alır.</p>

        <dl class="facts">
          <div>
            <dt>Firma</dt>
            <dd>{site.legalName}</dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd><a href={site.phone.href}>{site.phone.display}</a></dd>
          </div>
          <div>
            <dt>Adres</dt>
            <dd>{site.address}</dd>
          </div>
        </dl>

        <div class="btn-row">
          <a class="btn btn-dark" href="/iletisim/">İletişim Bilgileri</a>
        </div>
      </div>

      <div class="about-logo">
        <BrandLogo sizes="(min-width: 56em) 420px, 90vw" />
      </div>
    </div>
  </section>

  <HowWeWork compact />

  {
    visibleServices.length > 0 && (
      <section class="section section-light" aria-labelledby="hakkimizda-hizmet-baslik">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Hizmetler</p>
            <h2 id="hakkimizda-hizmet-baslik">Hizmetlerimiz</h2>
          </div>
          <ul class="link-list">
            {visibleServices.map((service) => (
              <li>
                <a href={`/hizmetler/${service.slug}/`}>
                  <Icon name={service.icon} />
                  <span>{service.title}</span>
                  {!service.onaylandi && <span class="draft-badge">TASLAK</span>}
                  <Icon class="link-list-arrow" name="arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <GallerySection variant="strip" />

  <section class="section section-light" aria-labelledby="konum-baslik">
    <div class="container">
      <div class="about-location">
        <h2 id="konum-baslik">Konum</h2>
        <p>{site.address}</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer">
            Yol tarifi al
          </a>
          <a class="btn btn-outline-dark" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            Google Maps’te aç
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
