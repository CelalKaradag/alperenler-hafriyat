---
import { site } from '../data/site';
import { publicFileExists } from '../utils/assets';

interface Props {
  title: string;
  description: string;
  /** true: site yayına çıksa bile bu sayfa noindex kalır (örn. taslak hukuki metin) */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const robots = site.publish.indexable && !noindex ? 'index, follow' : 'noindex, nofollow';

// Alan adı (astro.config.mjs → site) tanımlanmadıysa canonical ve og:url üretilmez.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;

// og:image mutlak adres ister: yalnızca alan adı tanımlıysa VE public/og-image.png (1200×630) varsa basılır.
const ogImage =
  Astro.site && publicFileExists('/og-image.png') ? new URL('/og-image.png', Astro.site).href : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
    </>
  )
}
