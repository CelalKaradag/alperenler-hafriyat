---
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  href: string;
  class?: string;
  /** WhatsApp ikonu (varsayılan: var) */
  icon?: boolean;
  /** Erişilebilir ad (varsayılan: "WhatsApp ile yazın") */
  label?: string;
}

const { href, class: className, icon = true, label = 'WhatsApp ile yazın' } = Astro.props;
---

<a class={className} href={href} target="_blank" rel="noopener" aria-label={label}>
  {icon && <WhatsAppIcon />}<slot>WhatsApp</slot>
</a>
