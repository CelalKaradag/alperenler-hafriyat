---
interface Props {
  href: string;
  class?: string;
  /** Yeşil WhatsApp ikonu (varsayılan: var) */
  icon?: boolean;
}

const { href, class: className, icon = true } = Astro.props;
---

<a class={className} href={href} target="_blank" rel="noopener" aria-label="WhatsApp ile yazın">
  {
    icon && (
      <svg
        class="wa-icon"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M12 3.2a8.8 8.8 0 0 0-7.5 13.4L3.2 20.8l4.3-1.1A8.8 8.8 0 1 0 12 3.2z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        ></path>
        <path
          d="M9 8.2c-.4.4-.6 1-.3 1.8.7 1.9 2.2 3.4 4.2 4.2.8.3 1.4.1 1.8-.3l.5-.7c.2-.3.1-.6-.2-.8l-1.3-.7c-.3-.1-.6 0-.8.2l-.3.3c-1.1-.4-2-1.3-2.4-2.4l.3-.3c.2-.2.3-.5.2-.8l-.7-1.3c-.2-.3-.5-.4-.8-.2z"
          fill="currentColor"></path>
      </svg>
    )
  }<slot>WhatsApp</slot>
</a>
