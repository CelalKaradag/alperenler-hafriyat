---
import type { Service } from '../data/services';
import { publicFileExists } from '../utils/assets';
import { imageSize } from '../utils/image-size';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  /** Hizmet veya makine (aynı alanlar) */
  service: Pick<Service, 'slug' | 'title' | 'summary' | 'icon' | 'image' | 'onaylandi'>;
  /** 1'den başlayan sıra; "01", "02" ... olarak gösterilir */
  index: number;
  /** Detay sayfası klasörü (varsayılan hizmetler) */
  basePath?: string;
}

const { service, index, basePath = '/hizmetler/' } = Astro.props;
const image = publicFileExists(service.image) ? service.image : null;
const size = image ? imageSize(image) : null;
const number = String(index).padStart(2, '0');
---

<article class:list={['service-card', image && 'service-card--img']}>
  {
    image && (
      <div class="service-card-media">
        <Picture
          src={image}
          alt=""
          width={size?.width ?? 1600}
          height={size?.height ?? 1000}
          sizes="(min-width: 72em) 25vw, (min-width: 30em) 50vw, 56px"
        />
      </div>
    )
  }
  <div class="service-card-body">
    <div class="service-card-top">
      <span class="service-card-number" aria-hidden="true">{number}</span>
      <Icon class="service-card-icon" name={service.icon} />
    </div>
    {!service.onaylandi && <span class="draft-badge">TASLAK</span>}
    <h3>
      <a href={`${basePath}${service.slug}/`}>{service.title}</a>
    </h3>
    <p>{service.summary}</p>
    <span class="service-card-more" aria-hidden="true">
      Detay<Icon name="arrow" />
    </span>
  </div>
</article>
