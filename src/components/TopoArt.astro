---
/**
 * Dekoratif topoğrafik eş yükselti deseni.
 * Desen sayfaya inline basılmaz: `scripts/generate-topo.mjs` build/dev öncesinde
 * public/topo/{hero,soft,low}.svg dosyalarını üretir; burada CSS background-image ile kullanılır
 * ve tarayıcı önbelleğe alır. Dosya yoksa (script çalışmadıysa) yalnızca desen görünmez.
 *
 *  hero → tam kaplayan, solda radyal maskeyle solan desen (hero, 404)
 *  soft → çok soluk desen (sayfa başlıkları, iletişim kartı)
 *  low  → soluk, hafif dosya (harita bekleme ekranı)
 */
interface Props {
  variant?: 'hero' | 'soft' | 'low';
}

const { variant = 'hero' } = Astro.props;
---

<div
  class:list={['topo-art', `topo-art--${variant}`, variant !== 'hero' && 'topo-art--soft']}
  aria-hidden="true"
>
</div>
