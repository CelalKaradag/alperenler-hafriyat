---
// Firma logo işareti (public/images/logo/logo-isaret-sari.svg ile aynı çizim, viewBox 0 0 100 100).
// Renk `currentColor` ile gelir: header/footer’da sarı (.brand-mark), başka yerde sınıfla değiştirilebilir.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  viewBox="0 0 100 100"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
