  <path
    d="M64 52 L84 40 C96 48 100 66 92 86 L62 86 C70 80 74 74 74 67 C74 60 70 55 64 52 Z"
  ></path>
  <path
    d="M63 86 L68.6 86 L67.6 96 L64 96 Z M70.4 86 L76 86 L75 96 L71.4 96 Z M77.8 86 L83.4 86 L82.4 96 L78.8 96 Z M85.2 86 L90.8 86 L89.8 96 L86.2 96 Z"
  ></path>
  <rect x="24" y="63" width="45" height="8"></rect>
</svg>