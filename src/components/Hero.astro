---
import { site, whatsappUrl } from '../data/site';
import { publicFileExists } from '../utils/assets';
import { getImageSize, getResponsive } from '../utils/responsive';
import Icon from './Icon.astro';
import TopoArt from './TopoArt.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  /** "Aşağı kaydır" göstergesinin gideceği bölüm, örn. "#firma" */
  scrollTarget?: string;
}

const { scrollTarget = '#icerik' } = Astro.props;

// Dosya kontrolü build/dev sırasında yapılır; olmayan dosya için hiçbir etiket basılmaz,
// tarayıcıda 404 isteği oluşmaz. Sıra önemlidir: her boyutta webm önce, mp4 yedek.
const variants = [
  { src: '/videos/hero-1080.webm', type: 'video/webm', wide: true },
  { src: '/videos/hero-1080.mp4', type: 'video/mp4', wide: true },
  { src: '/videos/hero-720.webm', type: 'video/webm', wide: false },
  { src: '/videos/hero-720.mp4', type: 'video/mp4', wide: false },
].filter((variant) => publicFileExists(variant.src));
const hasVideo = variants.length > 0;

// Posterler: yatay (masaüstü, 1080 videosu için) ve dikey (mobil, 720 videosu için).
// Mobilde (48em altı) dikey poster kullanılır; yoksa yatay poster. Poster artık bir <picture>
// (srcset + fetchpriority="high"): LCP görseli. Duyarlı türevler yoksa özgün dosya kullanılır.
const posterSrc = '/images/hero-poster.jpg';
const posterMobileSrc = '/images/hero-poster-720.jpg';
const photoSrc = '/images/hero.jpg';
const poster = publicFileExists(posterSrc) ? posterSrc : null;
const posterMobile = publicFileExists(posterMobileSrc) ? posterMobileSrc : null;
const photo = publicFileExists(photoSrc) ? photoSrc : null;
// Masaüstü (varsayılan <img>) için: yatay poster → dikey poster → fotoğraf
const mainPoster = poster ?? posterMobile ?? photo;
const hasMedia = hasVideo || mainPoster !== null;

const mainResp = mainPoster ? getResponsive(mainPoster) : null;
const mobileResp = posterMobile ? getResponsive(posterMobile) : null;
const mainSize = mainPoster ? getImageSize(mainPoster) : null;
// Mobilde ayrı dikey poster varsa (ve ana poster farklıysa) media'lı <source>
const useMobileSource = Boolean(posterMobile && poster && posterMobile !== mainPoster);
// <link rel="preload"> için tür tanımlı olmayan öznitelikler (imagesrcset/imagesizes/fetchpriority)
// AVIF türevi varsa önyükleme AVIF'i alır (type ile: desteklemeyen tarayıcı atlar, <picture> yine yükler)
const preloadExtras = (resp: ReturnType<typeof getResponsive>) => ({
  imagesrcset: resp?.avifSet ?? resp?.webpSet,
  type: resp?.avifSet ? 'image/avif' : undefined,
  imagesizes: resp ? '100vw' : undefined,
  fetchpriority: 'high' as const,
});
const MOBILE = '(max-width: 47.99em)';
const DESKTOP = '(min-width: 48em)';
// <video> için tür tanımlı olmayan, standart dışı öznitelikler
const videoExtras = { disablepictureinpicture: true, disableremoteplayback: true };
---

{/* Önyükleme: ekrana göre doğru poster (media), duyarlı türev varsa imagesrcset ile, yüksek öncelik */}
{
  mainPoster && (
    <>
      {useMobileSource && posterMobile && (
        <link rel="preload" as="image" href={posterMobile} media={MOBILE} {...preloadExtras(mobileResp)} />
      )}
      <link
        rel="preload"
        as="image"
        href={mainPoster}
        media={useMobileSource ? DESKTOP : undefined}
        {...preloadExtras(mainResp)}
      />
    </>
  )
}

<section class:list={['hero', 'on-dark', hasMedia ? 'hero--media' : 'hero--plain']}>
  {
    mainPoster && (
      <picture class="hero-poster" aria-hidden="true">
        {useMobileSource && mobileResp?.avifSet && (
          <source type="image/avif" srcset={mobileResp.avifSet} sizes="100vw" media={MOBILE} />
        )}
        {useMobileSource && mobileResp && (
          <source type="image/webp" srcset={mobileResp.webpSet} sizes="100vw" media={MOBILE} />
        )}
        {useMobileSource && posterMobile && !mobileResp && (
          <source srcset={posterMobile} media={MOBILE} />
        )}
        {mainResp?.avifSet && <source type="image/avif" srcset={mainResp.avifSet} sizes="100vw" />}
        {mainResp && <source type="image/webp" srcset={mainResp.webpSet} sizes="100vw" />}
        <img
          src={mainPoster}
          srcset={mainResp?.jpgSet}
          sizes={mainResp ? '100vw' : undefined}
          alt=""
          width={mainSize?.width ?? 1920}
          height={mainSize?.height ?? 1080}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    )
  }  {
    hasVideo && (
      <div class="hero-media" data-hero-media data-sources={JSON.stringify(variants)} aria-hidden="true">
        {/* JavaScript kapalıyken: tek video + native loop. JS açıkken videoları betik oluşturur. */}
        <noscript>
          <video
            class="hero-video is-visible"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            tabindex="-1"
            aria-hidden="true"
            {...videoExtras}
          >
            {variants.map((variant) => (
              <source
                src={variant.src}
                type={variant.type}
                media={variant.wide ? '(min-width: 48em)' : '(max-width: 47.99em)'}
              />
            ))}
          </video>
        </noscript>
      </div>
    )
  }
  {hasMedia && <div class="hero-overlay" aria-hidden="true" />}
  {hasMedia && <div class="hero-vignette" aria-hidden="true" />}
  {!hasMedia && <TopoArt />}
  {/* Header okunurluğu için hero'nun en üstünde yumuşak koyu geçiş (şerit değil; header şeffafken) */}
  <div class="hero-header-fade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="eyebrow">Malatya · Yeşilyurt</p>
    {/* Satır satır alttan maskeyle açılır; ekran okuyucu `Alperenler Hafriyat` okur */}
    <h1>
      <span class="h1-line"><span>Alperenler</span></span>{' '}
      <span class="h1-line"><span>Hafriyat</span></span>
    </h1>
    <p class="hero-sub">
      <span class="hero-sub-desktop">
        {site.legalName}, Malatya genelinde hizmet veriyor; merkezimiz Yeşilyurt’ta. İşinizin ihtiyacını
        anlatmak için doğrudan bizi arayabilirsiniz.
      </span>
      <span class="hero-sub-mobile"
        >Malatya genelinde hafriyat, kazı, altyapı ve iş makinesi hizmetleri. Merkezimiz Yeşilyurt'ta.</span
      >
    </p>
    <div class="btn-row">
      <a class="btn btn-primary btn-lg" href={site.phone.href}>
        <Icon class="btn-icon" name="phone" />Hemen Ara
      </a>
      {
        whatsappUrl ? (
          <WhatsAppButton class="btn btn-outline-light btn-lg" href={whatsappUrl} />
        ) : (
          <a class="btn btn-outline-light btn-lg" href="/iletisim/">İletişim</a>
        )
      }
    </div>
  </div>

  {
    hasVideo && (
      <button
        class="hero-toggle"
        type="button"
        data-hero-toggle
        aria-pressed="false"
        aria-label="Arka plan videosunu durdur"
        hidden
      >
        <svg class="hero-toggle-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z" fill="currentColor" />
        </svg>
        <svg class="hero-toggle-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 4l13 8-13 8z" fill="currentColor" />
        </svg>
        <span class="hero-toggle-pause" aria-hidden="true">Durdur</span>
        <span class="hero-toggle-play" aria-hidden="true">Oynat</span>
      </button>
    )
  }

  <a class="hero-scroll" href={scrollTarget} aria-label="Aşağı kaydır">
    <svg
      class="hero-scroll-arrow"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </a>
</section>
