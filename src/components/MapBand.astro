---
import { mapsDirectionsUrl, mapsUrl, site, whatsappUrl } from '../data/site';
import EmailText from './EmailText.astro';
import Icon from './Icon.astro';
import TikTokLink from './TikTokLink.astro';
import MapCard from './MapCard.astro';
import WhatsAppButton from './WhatsAppButton.astro';
---

<!--
  Tam genişlik (full-bleed) harita şeridi + üstünde yüzen iletişim kartı.
  Masaüstü/tablet (48em üstü): kart haritanın üstünde, container’ın sol kenarına hizalı.
  Mobil: harita (~260 px), kart haritanın ALTINDA normal akışta.
-->
<section class="map-band on-dark" aria-label="Konum ve iletişim">
  <div class="map-band-stage">
    <MapCard />

    <div class="container map-band-overlay">
      <div class="map-info">
        <p class="eyebrow">Konum &amp; İletişim</p>
        <p class="map-info-name">{site.legalName}</p>
        <address>{site.address}</address>
        <div class="map-info-divider" aria-hidden="true"></div>
        <p class="map-info-phone"><a href={site.phone.href}>{site.phone.display}</a></p>
        {
          whatsappUrl && (
            <p class="map-info-wa">
              <WhatsAppButton href={whatsappUrl} />
            </p>
          )
        }
        {
          site.email && (
            <p class="map-info-mail">
              <a href={`mailto:${site.email}`}>
                <Icon name="mail" />
                <span class="mail-text"><EmailText email={site.email} /></span>
              </a>
            </p>
          )
        }
        {
          (site.social.tiktok || site.googleWriteReviewUrl) && (
            <p class="map-info-social">
              {site.social.tiktok && <TikTokLink />}
              {site.googleWriteReviewUrl && (
                <a
                  class="social-link"
                  href={site.googleWriteReviewUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-review-link
                >
                  Google'da yorum yazın<span class="visually-hidden"> (yeni sekmede açılır)</span>
                </a>
              )}
            </p>
          )
        }
        <div class="map-info-actions">
          <a
            class="btn btn-primary"
            href={mapsDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Yol tarifi al<span class="visually-hidden"> (yeni sekmede açılır)</span>
          </a>
          <a class="btn btn-outline-light" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            Google Maps’te aç<span class="visually-hidden"> (yeni sekmede açılır)</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container map-band-note">
    <p class="map-note">Harita Google tarafından sağlanır.</p>
  </div>
</section>
