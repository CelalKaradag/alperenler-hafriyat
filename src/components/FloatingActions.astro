---
import { whatsappUrl } from '../data/site';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<!--
  Yüzen düğmeler (tüm genişlikler). Telefonda yalnızca WhatsApp: ilk belirişte birkaç saniye yazılı durur, sonra ikona kapanır.
  Görünürlüğü src/scripts/floating-actions.js yönetir: WhatsApp hero görünürken gizli, aşağı inince belirir;
  masaüstünde ilk 600 px'ten sonra yazı kısmı kapanıp yalnızca ikon kalır (hover/odakta açılır); "yukarı çık"
  (yalnızca masaüstü) sayfa yarıdan sonra görünür. WhatsApp numarası yoksa WhatsApp düğmesi basılmaz.
-->
<aside class="floating-actions" data-floating aria-label="Hızlı iletişim">
  <button class="to-top" type="button" data-to-top aria-label="Sayfanın başına çık">
    <Icon name="arrowUp" />
  </button>
  {
    whatsappUrl && (
      <WhatsAppButton
        class="wa-float"
        href={whatsappUrl}
        icon={false}
        label={false}
      >
        <span class="wa-float-icon">
          <WhatsAppIcon />
        </span>
        <span class="wa-float-text">
          <span class="wa-float-small">WhatsApp</span>
          <span class="wa-float-big">Teklif için yazın</span>
        </span>
      </WhatsAppButton>
    )
  }
</aside>
