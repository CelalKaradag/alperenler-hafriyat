---
import { getGalleryEntries } from '../utils/gallery';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  /** home: ana sayfa "Sahadan" (öne çıkan en çok 6 öğe + /galeri/ bağlantısı); page: /galeri/ (hepsi + filtre) */
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;

// Dosyası public/ altında olmayan öğeler hiç render edilmez (kırık görsel/video olmaz).
const all = getGalleryEntries();
const featured = all.filter((entry) => entry.item.featured);
const entries = variant === 'page' ? all : (featured.length > 0 ? featured : all).slice(0, 6);

const photoCount = entries.filter((entry) => entry.kind === 'image').length;
const videoCount = entries.length - photoCount;

// Sayfa üstündeki ilk satır (masaüstünde 3 öğe) hemen yüklenir, kalan her şey lazy.
// Ana sayfada galeri sayfanın aşağısındadır: hepsi lazy.
const eagerCount = variant === 'page' ? 3 : 0;

// Filtre çubuğu JavaScript yoksa gizli kalır (hepsi görünür); gallery-filter.js açar.
let hasImages = false;
---

{
  entries.length > 0 && (
    <section
      class:list={['section', 'section-light', variant === 'page' && 'section--flush-top']}
      aria-labelledby={variant === 'home' ? 'galeri-baslik' : undefined}
      aria-label={variant === 'page' ? 'Fotoğraf ve videolar' : undefined}
    >
      <div class="container reveal" data-lightbox-root>
        {
          variant === 'home' && (
            <div class="section-head">
              <p class="eyebrow">Çalışmalarımız</p>
              <h2 id="galeri-baslik">Sahadan</h2>
            </div>
          )
        }

        {
          variant === 'page' && photoCount > 0 && videoCount > 0 && (
            <>
              <div class="gallery-filters" role="group" aria-label="Galeri filtresi" data-gallery-filters hidden>
                <button type="button" data-filter="all" aria-pressed="true">
                  Tümü <span class="gallery-filter-count">{entries.length}</span>
                </button>
                <button type="button" data-filter="image" aria-pressed="false">
                  Fotoğraflar <span class="gallery-filter-count">{photoCount}</span>
                </button>
                <button type="button" data-filter="video" aria-pressed="false">
                  Videolar <span class="gallery-filter-count">{videoCount}</span>
                </button>
              </div>
              <p class="visually-hidden" role="status" aria-live="polite" data-gallery-status />
            </>
          )
        }

        {/* Mobilde (48em altı): ana sayfada yatay kaydırmalı şerit, /galeri/'de 2 sütunlu kare ızgara */}
        <ul class:list={['gallery-grid', `gallery-grid--${variant}`]} data-gallery-grid={variant}>
          {entries.map((entry, i) => {
            if (entry.kind === 'image') {
              hasImages = true;
              return (
                <li class="gallery-item" data-kind="image">
                  <button
                    type="button"
                    class="gallery-open"
                    data-lightbox-open
                    data-kind="image"
                    data-src={entry.src}
                    data-webp={entry.webp ?? ''}
                    data-alt={entry.alt}
                    data-width={entry.width}
                    data-height={entry.height}
                    aria-haspopup="dialog"
                    aria-label={`Büyüt: ${entry.alt}`}
                  >
                    <Picture
                      src={entry.src}
                      alt={entry.alt}
                      width={entry.width}
                      height={entry.height}
                      loading={i < eagerCount ? 'eager' : 'lazy'}
                      sizes="(min-width: 64em) 33vw, (min-width: 40em) 50vw, 78vw"
                    />
                  </button>
                </li>
              );
            }
            hasImages = true;
            return (
              <li class="gallery-item" data-kind="video">
                {/* Masaüstü: kendi yerinde oynatılan video (preload="none", poster, muted, controls) */}
                <figure class="gallery-video">
                  <video
                    controls
                    muted
                    preload="none"
                    playsinline
                    width={entry.width}
                    height={entry.height}
                    poster={entry.poster}
                    aria-label={entry.title}
                  >
                    <source src={entry.src} type="video/mp4" />
                  </video>
                </figure>
                {/* Mobil: poster + oynat ikonu; dokununca lightbox içinde oynar */}
                <button
                  type="button"
                  class="gallery-open gallery-open--video"
                  data-lightbox-open
                  data-kind="video"
                  data-video={entry.src}
                  data-poster={entry.poster ?? ''}
                  data-alt={entry.title}
                  data-width={entry.width}
                  data-height={entry.height}
                  aria-haspopup="dialog"
                  aria-label={`Videoyu oynat: ${entry.title}`}
                >
                  {entry.poster && (
                    <img
                      src={entry.poster}
                      alt=""
                      width={entry.width}
                      height={entry.height}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class="gallery-play" aria-hidden="true">
                    <Icon name="play" />
                  </span>
                </button>
              </li>
            );
          })}
        </ul>

        {
          variant === 'home' && entries.length > 1 && (
            <p class="gallery-counter" data-carousel-count aria-hidden="true" hidden />
          )
        }

        {
          variant === 'home' && all.length > entries.length && (
            <p class="gallery-more">
              <a class="text-link" href="/galeri/">
                Tüm fotoğraf ve videolar<span class="arrow" aria-hidden="true">→</span>
              </a>
            </p>
          )
        }

        {
          hasImages && (
            <dialog class="lightbox" data-lightbox aria-label="Görsel ve video büyütme">
              <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Kapat">
                <Icon name="close" />
              </button>
              <button type="button" class="lightbox-btn lightbox-prev" data-lightbox-prev aria-label="Önceki">
                <Icon name="arrow" />
              </button>
              <button type="button" class="lightbox-btn lightbox-next" data-lightbox-next aria-label="Sonraki">
                <Icon name="arrow" />
              </button>
              <div class="lightbox-stage">
                <picture data-lightbox-picture>
                  <source data-lightbox-source type="image/webp" />
                  <img data-lightbox-img alt="" />
                </picture>
                <video class="lightbox-video" data-lightbox-video controls muted playsinline hidden />
              </div>
              <div class="lightbox-bar">
                <p class="lightbox-caption" data-lightbox-caption />
                <p class="lightbox-count" data-lightbox-count aria-live="polite" />
              </div>
            </dialog>
          )
        }
      </div>
    </section>
  )
}
