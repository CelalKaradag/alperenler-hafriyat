# Yerel deneme için bu dosyayı .env olarak kopyalayabilirsiniz (.env git'e girmez).
# "true": onaylanmamış (taslak) hizmetler ve SSS build'e girer, "TASLAK" rozetli görünür,
# sayfa üstünde "Önizleme sürümü" şeridi çıkar. Gerçek yayında vermeyin veya "false" yapın.
# (npm run dev'de taslaklar bu değişkenden bağımsız olarak zaten görünür.)
PUBLIC_SHOW_DRAFTS=false
