{
  // Cloudflare Workers (YALNIZCA statik dosya): Worker kodu yok, yalnızca dist/ yayınlanır.
  // Yayın: npm run deploy:preview (README: "Yayın: Cloudflare Workers"). Başlıklar: public/_headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alperenler-hafriyat",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
